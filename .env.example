# Supabase: URL del proyecto y clave pública (anon / publishable). Nunca uses service_role aquí.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica

# Dirección pública de la web (https, sin barra final). La app Android la necesita para incluir
# el enlace al compartir una promoción; sin ella se comparte solo el texto.
# Ejemplo: VITE_PUBLIC_SITE_URL=https://drivefix.tu-dominio.com
VITE_PUBLIC_SITE_URL=
